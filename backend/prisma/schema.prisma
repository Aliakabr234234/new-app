generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String
  name                String
  role                Role           @default(USER)
  isActive            Boolean        @default(true)
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  refreshTokens       RefreshToken[]
  createdResources    Resource[]     @relation("ResourceCreatedBy")
  createdProjects     Project[]      @relation("ProjectCreatedBy")
  auditLogs           AuditLog[]

  // New relations
  createdScenarios    Scenario[]
  createdTemplates    ProjectTemplate[]
  requestedRequests   ResourceRequest[] @relation("RequestedBy")
  reviewedRequests    ResourceRequest[] @relation("ReviewedBy")
  notifications       Notification[]
  notificationPref    NotificationPreference?
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Resource {
  id                 String       @id @default(uuid())
  name               String
  role               String
  dailyCapacityHours Int          @default(8)
  colorTag           String
  isActive           Boolean      @default(true)
  hourlyRate         Float?
  currency           String       @default("USD")
  createdById        String
  createdBy          User         @relation("ResourceCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  assignments        Assignment[]

  // New relations
  skills             ResourceSkill[]
  leaves             Leave[]
  timeLogs           TimeLog[]
  resourceRequests   ResourceRequest[]
  healthScores       WorkloadHealthScore[]
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  colorTag    String
  status      ProjectStatus @default(PLANNING)
  budget      Float?
  currency    String        @default("USD")
  createdById String
  createdBy   User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  assignments Assignment[]

  // New relations
  requiredSkills  ProjectSkill[]
  timeLogs        TimeLog[]
  resourceRequests ResourceRequest[]
}

model Assignment {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  dailyHours Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  details   Json?
  ip        String?
  createdAt DateTime @default(now())
}

// ==========================================
// MODULE 3 — Skills & Competency Matrix
// ==========================================

model Skill {
  id        String          @id @default(uuid())
  name      String          @unique
  category  String
  createdAt DateTime        @default(now())
  resources ResourceSkill[]
  projects  ProjectSkill[]
}

model ResourceSkill {
  id           String  @id @default(uuid())
  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency  String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  yearsExp     Int?

  @@unique([resourceId, skillId])
}

model ProjectSkill {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  required  Boolean @default(true)

  @@unique([projectId, skillId])
}

// ==========================================
// MODULE 2 — Leave & Time Off
// ==========================================

model Leave {
  id          String   @id @default(uuid())
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  type        String   @default("VACATION") // VACATION, SICK, PUBLIC_HOLIDAY, TRAINING, OTHER
  startDate   DateTime
  endDate     DateTime
  note        String?
  createdById String
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PublicHoliday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  recurring Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==========================================
// MODULE 6 — Actual vs Planned Time Tracking
// ==========================================

model TimeLog {
  id          String   @id @default(uuid())
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  hoursLogged Float
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([resourceId, projectId, date])
}

// ==========================================
// MODULE 5 — Resource Request & Approval
// ==========================================

model ResourceRequest {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  resourceId    String
  resource      Resource @relation(fields: [resourceId], references: [id])
  requestedById String
  requestedBy   User     @relation("RequestedBy", fields: [requestedById], references: [id])
  reviewedById  String?
  reviewedBy    User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  startDate     DateTime
  endDate       DateTime
  dailyHours    Int
  justification String?
  reviewNote    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================
// MODULE 10 — Notifications
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // conflict, request_approved, request_rejected, budget_alert, digest
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
  emailDigest    Boolean @default(true)
  digestDay      String  @default("MONDAY")
  digestTime     String  @default("09:00")
  conflictAlerts Boolean @default(true)
  requestUpdates Boolean @default(true)
  budgetAlerts   Boolean @default(true)
}

// ==========================================
// MODULE 9 — Project Templates
// ==========================================

model ProjectTemplate {
  id           String                @id @default(uuid())
  name         String
  description  String?
  colorTag     String                @default("#6366F1")
  durationDays Int
  createdById  String
  createdBy    User                  @relation(fields: [createdById], references: [id])
  createdAt    DateTime              @default(now())
  roles        ProjectTemplateRole[]
}

model ProjectTemplateRole {
  id              String          @id @default(uuid())
  templateId      String
  template        ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  roleTitle       String
  dailyHours      Int
  startOffsetDays Int
  durationDays    Int
}

// ==========================================
// MODULE 4 — Scenario Planning
// ==========================================

model Scenario {
  id          String               @id @default(uuid())
  name        String
  description String?
  isPublished Boolean              @default(false)
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  assignments ScenarioAssignment[]
}

model ScenarioAssignment {
  id         String   @id @default(uuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  projectId  String
  resourceId String
  startDate  DateTime
  endDate    DateTime
  dailyHours Int
  action     String   // "add", "modify", "remove"
}

// ==========================================
// MODULE 12 — Workload Health Scores
// ==========================================

model WorkloadHealthScore {
  id                  String   @id @default(uuid())
  resourceId          String
  resource            Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  overallScore        Int
  utilizationBalance  Int
  scheduleStability   Int
  burnoutRisk         Int
  leaveBalance        Int
  actualAlignment     Int
  recommendation      String?
  calculatedAt        DateTime @default(now())
}
